# Maintainer: company (not AUR)
# Binary is Keeper's official amd64 .deb. This file only unpacks it.
# Bump pkgver + sha256sums from https://keepersecurity.com/desktop_electron/SHASUM256.txt
# Do not copy PKGBUILDs from aur.archlinux.org.

pkgname=keeper-password-manager
pkgver=18.6.6
pkgrel=1
pkgdesc='Keeper Desktop (vendor .deb wrapper). SSH agent lives in Settings > Developer.'
arch=('x86_64')
url='https://www.keepersecurity.com/'
license=('LicenseRef-Keeper')
depends=('gtk3' 'nss' 'libxss' 'libsecret' 'libnotify' 'xdg-utils')
source=("https://keepersecurity.com/desktop_electron/Linux/repo/deb/keeperpasswordmanager_${pkgver}_amd64.deb")
sha256sums=('53b84317b9bc6db89c31a7c2ec8b34fd1ec6d8689c5c42e0e64caa02ab18fe5c')

package() {
  bsdtar -xf data.tar.* -C "$pkgdir"
}

# After clone: run ../../scripts/propose-update.sh keeper-password-manager to fill pkgver/sha256sums.
